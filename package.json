{
  "name": "dsh-auth-remote",
  "version": "0.1.3",
  "description": "Single-user remote authentication for DeepSeek Harness: password, TOTP and revocable sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenLuoi/dsh-auth-remote.git"
  },
  "homepage": "https://github.com/ChenLuoi/dsh-auth-remote#readme",
  "bugs": {
    "url": "https://github.com/ChenLuoi/dsh-auth-remote/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-auth-remote": "./dist/cli.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.host.json --emitDeclarationOnly",
    "dev": "node scripts/build.mjs --watch",
    "dev:prepare": "node scripts/dev-prepare.mjs",
    "dev:install": "pnpm pack:local && pnpm dev:prepare && node scripts/dev-install.mjs",
    "dev:start": "node scripts/dev-start.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "node scripts/check-package.mjs",
    "check:deployment": "node scripts/verify-deployment.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "pnpm build && tsx --test tests/integration/*.test.ts",
    "test:cli": "node scripts/prepare-test.mjs && pnpm build && node scripts/pack.mjs && tsx --test --test-concurrency=1 tests/cli/*.test.ts",
    "test:browser": "node scripts/prepare-test.mjs && pnpm build && node scripts/pack.mjs && tsx --test --test-concurrency=1 tests/browser/*.spec.ts",
    "check:static": "pnpm typecheck && pnpm format:check && pnpm build && pnpm check:package && pnpm check:deployment && pnpm check:docs && pnpm check:release",
    "check": "pnpm check:static && pnpm test:unit && pnpm test:integration && pnpm test:cli && pnpm test:browser",
    "release:pack": "pnpm check:static && node scripts/pack.mjs",
    "pack:local": "pnpm release:pack",
    "smoke:packed": "pnpm dev:prepare && node scripts/dev-install.mjs && node scripts/smoke.mjs",
    "smoke": "pnpm pack:local && pnpm smoke:packed"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.1",
    "@types/semver": "7.7.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "qrcode": "1.5.4",
    "react": "18.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "semver": "7.7.3"
  }
}
